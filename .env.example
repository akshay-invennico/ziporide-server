# PORT
PORT=3000

# MONGO URL
MONGODB_URL=mongodb://127.0.0.1:27017/ziporide-server

# JWT
JWT_SECRET=thisisasamplesecret
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30

# SMTP configuration
SMTP_HOST=email-server
SMTP_PORT=587
SMTP_USERNAME=email-server-username
SMTP_PASSWORD=email-server-password
EMAIL_FROM=support@yourapp.com

# Twilio config
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Stripe config
# Get these from https://dashboard.stripe.com/apikeys (use test keys for dev)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Signing secret from Stripe webhook dashboard (stripe listen --print-secret for local dev)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# Price ID of the driver monthly subscription plan created in Stripe dashboard
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
# Currency code (ISO 4217) – defaults to GBP
STRIPE_CURRENCY=GBP
# Deep link or URL to return the driver to after Checkout or portal
DRIVER_SUBSCRIPTION_RETURN_URL=http://localhost:3000/driver/subscription